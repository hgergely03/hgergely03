---
import type { ICarouselItem } from './CarouselItem.astro';
import CarouselItem from './CarouselItem.astro';

export interface Props {
    items: ICarouselItem[];
}

const { items } = Astro.props;
---

<style>
    .carousel {
        display: flex;
        gap: var(--spacing-extra-extra-large);
    }

    @media screen and (max-width: 768px) {
        .carousel {
            flex-direction: column;
            gap: var(--spacing-medium);
        }
    }
</style>

<div class="carousel">
    {items.map((item) => (
        <CarouselItem
            label={item.label}
            decorationSrc={item.decorationSrc}
            decorationAlt={item.decorationAlt}
        />
    ))}
</div>