---
import ProjectCard from "../ProjectCard/ProjectCard.astro";
import type { IBentoItem } from "./BentoItem";

export interface Props {
    items: IBentoItem[];
    class?: string | string[];
    href?: string;
}

const { items, class: className, href, ...rest } = Astro.props;
---

<style>
    .bento {
        display: grid;
        column-gap: var(--spacing-small);
        row-gap: var(--spacing-small);
        width: 100%;
        height: 70vh;
    }

    .layout {
        grid-template-columns: repeat(9, 1fr);
        grid-template-rows: repeat(9, 1fr);
        grid-template-areas:
            "a a a a a a c c c"
            "a a a a a a c c c"
            "a a a a a a c c c"
            "a a a a a a c c c"
            "a a a a a a c c c"
            "b b b b b b c c c"
            "b b b b b b c c c"
            "b b b b b b c c c"
            "b b b b b b c c c";
    }

    .project-card:nth-of-type(1) {
        grid-area: a;
    }

    .project-card:nth-of-type(2) {
        grid-area: b;
    }

    .project-card:nth-of-type(3) {
        grid-area: c;
    }

    /* // TODO: Different layout for smaller screens? (see Figma) */
    @media screen and (max-width: 1200px) {
        .layout {
            grid-template-columns: repeat(3, 1fr);
            grid-template-rows: 1fr;
            grid-template-areas: "a b c";
            gap: var(--spacing-normal);
            height: 40vh;
        }
    }

    @media screen and (max-width: 996px) {
        .layout {
            grid-template-columns: 1fr;
            grid-template-rows: repeat(3, 1fr);
            grid-template-areas:
                "a"
                "b"
                "c";
            gap: var(--spacing-normal);
        }
    }
</style>

<div class="bento layout">
    {
        items.map((item) => (
            <ProjectCard
                label={item.label}
                backgroundImageSrc={item.backgroundImageSrc}
                href={item.href}
            />
        ))
    }
</div>
