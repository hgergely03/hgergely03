---
import type { ImageMetadata } from 'astro';

export interface Props {
    paragraphs: {
        title: string;
        body: string;
        imgSrc: ImageMetadata;
        imgAlt: string;
    }[],
}

const { paragraphs } = Astro.props;
---

<style>
    .paragraph-container {
        display: flex;
        flex-direction: column;
        gap: var(--spacing-extra-extra-large);
        max-width: 50vw;
    }

    .content-paragraph {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: var(--spacing-extra-extra-large);
        align-items: center;
    }

    .content-text {
        display: flex;
        flex-direction: column;
        gap: var(--spacing-medium);
    }

    p, h2 {
        margin: 0;
    }

    img {
        aspect-ratio: 4 / 5.6;
        max-width: 100%;
        object-fit: cover;
        border-radius: var(--spacing-small);
    }

    @media screen and (max-width: 1200px) {
        .paragraph-container {
            max-width: 100%;
        }
        
        .content-paragraph {
            grid-template-columns: 1fr;
            gap: var(--spacing-large);
        }
    }

    @media screen and (max-width: 768px) {
        .content-paragraph {
            position: relative;
        }

        .content-paragraph > .content-text {
            position: absolute;
            bottom: 0;
            left: 0;
            max-width: 100%;
            padding: var(--spacing-large) var(--spacing-layout);
            background-image: linear-gradient(180deg, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, 0.8) 100%);
        }

        img {
            aspect-ratio: unset;
            height: 95vh;
        }

        .content-text {
            gap: var(--spacing-small);
        }

        h2 {
            font-weight: 500;
            font-size: 1.2rem;
        }

        p {
            font-weight: 300;
        }
    }
</style>

<div class="paragraph-container">
    <div id="start"></div>
    {paragraphs.map((paragraph) => (
        <section class="content-paragraph">
            <div class="content-text">
                <!-- TODO: 90% white text color (CSS vars and global rules?) -->
                <h2>{paragraph.title}</h2>
                <p>{paragraph.body}</p>
            </div>
            <img src={paragraph.imgSrc.src} alt={paragraph.imgAlt} />
        </section>
    ))}
    <div id="end"></div>
</div>

<script>
    import gsap from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";
    import { ScrollToPlugin } from "gsap/ScrollToPlugin";

    function goToSection(section: Element) {
        gsap.to(window, {
            scrollTo: {y: section, autoKill: false},
            duration: 1,
            ease: "power2.inOut",
        });
    }

    // Only run the scroll snap animation on mobile devices
    const mobileBreakpoint = 768;
    if(window.screen.width < mobileBreakpoint) {
        gsap.registerPlugin(ScrollTrigger);
        gsap.registerPlugin(ScrollToPlugin);

        document.querySelectorAll(".content-paragraph").forEach(section => {
            ScrollTrigger.create({
                trigger: section,
                onEnter: () => goToSection(section),
            });
            
            ScrollTrigger.create({
                trigger: section,
                start: "bottom bottom",
                onEnterBack: () => goToSection(section),
            });
        });
    }
</script>