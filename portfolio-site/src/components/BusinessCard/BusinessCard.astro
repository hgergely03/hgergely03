---
import { Image } from "astro:assets";
import GitHubIcon from "../../assets/img/icons/github.svg";
import LinkedInIcon from "../../assets/img/icons/linkedin.svg";
import DribbbleIcon from "../../assets/img/icons/dribbble.svg";
---

<style>
    .business-card {
        display: flex;
        justify-content: center;
        gap: var(--spacing-extra-extra-large);
        width: 100%;
        padding: var(--spacing-extra-extra-large) 0;
        background-image: linear-gradient(var(--color-dark), var(--color-dark)), var(--gradient-light);
        
        border-radius: var(--spacing-small);
    }

    .icon {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: var(--spacing-normal);
        font-size: 1.5rem;
        color: var(--gradient-light);
    }

    .icon img {
        width: var(--spacing-extra-extra-large);
        height: auto;
    }

    a {
        text-decoration: none;
    }

    @media screen and (max-width: 992px) {
        .business-card {
            flex-direction: column;
            gap: var(--spacing-extra-large);
            width: fit-content;
            padding: var(--spacing-extra-large) var(--spacing-extra-large);
        }
    }
</style>

<!-- TODO: create class for light gradient border and document .gradient-border -->
<div class="business-card gradient-border">
    <a class="icon" href="" target="_blank" rel="noopener noreferrer">
        <Image src={GitHubIcon} alt="GitHub Icon" />
        hgergely03
    </a>
    <a class="icon" href="" target="_blank" rel="noopener noreferrer">
        <Image src={LinkedInIcon} alt="LinkedIn Icon" />
        hgergely03
    </a>
    <a class="icon" href="" target="_blank" rel="noopener noreferrer">
        <Image src={DribbbleIcon} alt="Dribbble Icon" />
        hgergely03
    </a>
</div>