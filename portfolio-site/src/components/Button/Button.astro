---
export interface Props {
    href: string;
    label?: string;
    isDark?: boolean;
    isPrimaryStroke?: boolean;
}

const { href, label = "", isDark = true, isPrimaryStroke = true } = Astro.props;
---

<style>
    .button {
        display: flex;
        gap: var(--spacing-extra-small);
        padding: var(--spacing-extra-small) var(--spacing-medium);
        text-decoration: none;
        color: var(--color-light);
        width: max-content;
        background-image:
            linear-gradient(var(--color-dark), var(--color-dark)),
            var(--gradient-primary);
        border-radius: 2rem;
        box-shadow: 0 0 7px 2px rgba(255, 97, 97, 0.4);
        font-size: 1rem;
        font-weight: bold;
    }

    .button.light-stroke {
        border: 1px solid rgba(255, 255, 255, 0.2);
        box-shadow: 0 0 4px 1px rgba(255, 255, 255, 0.2);
    }

    .button.light-background {
        background-image: linear-gradient(var(--color-light));
        color: var(--color-dark);
    }
</style>

<a
    class:list={[
        "button",
        {
            "light-background": !isDark,
            "light-stroke": !isPrimaryStroke,
            "gradient-border": isPrimaryStroke && isDark,
        },
    ]}
    href={href}
>
    {label}
    <slot />
</a>
