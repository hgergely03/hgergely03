---
import Signature from "./Signature.astro";
---

<style>
    @property --1-x-position {
        syntax: "<percentage>";
        inherits: false;
        initial-value: 5%;
    }

    @property --1-y-position {
        syntax: "<percentage>";
        inherits: false;
        initial-value: 10%;
    }

    @property --2-x-position {
        syntax: "<percentage>";
        inherits: false;
        initial-value: 80%;
    }

    @property --2-y-position {
        syntax: "<percentage>";
        inherits: false;
        initial-value: 20%;
    }

    @property --3-x-position {
        syntax: "<percentage>";
        inherits: false;
        initial-value: 0%;
    }

    @property --3-y-position {
        syntax: "<percentage>";
        inherits: false;
        initial-value: 170%;
    }

    @property --1-gradient-1 {
        syntax: "<color>";
        inherits: false;
        initial-value: rgba(0, 0, 0, 1);
    }

    @property --1-gradient-2 {
        syntax: "<color>";
        inherits: false;
        initial-value: rgba(0, 0, 0, 0);
    }

    @property --2-gradient-1 {
        syntax: "<color>";
        inherits: false;
        initial-value: rgba(0, 0, 0, 1);
    }

    @property --2-gradient-2 {
        syntax: "<color>";
        inherits: false;
        initial-value: rgba(0, 0, 0, 0);
    }

    @property --3-gradient-1 {
        syntax: "<color>";
        inherits: false;
        initial-value: rgba(122, 0, 228, 1);
    }

    @property --3-gradient-2 {
        syntax: "<color>";
        inherits: false;
        initial-value: rgba(122, 0, 228, 0.5);
    }

    .lights {
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
        animation: gradient 5s ease-in-out infinite alternate forwards;
        background:
            radial-gradient(
                circle at var(--1-x-position) var(--1-y-position),
                var(--1-gradient-1),
                var(--1-gradient-2) 80%
            ),
            radial-gradient(
                circle at var(--2-x-position) var(--2-y-position),
                var(--2-gradient-1),
                var(--2-gradient-2) 70%
            ),
            radial-gradient(
                circle at var(--3-x-position) var(--3-y-position),
                var(--3-gradient-1),
                var(--3-gradient-2) 70%
            );
        /** TODO: Test browser compatibility
            As an alternative, see SVG masking: https://www.w3schools.com/css/css3_masking_svg.asp */
        --mask: linear-gradient(
                to bottom,
                rgba(0, 0, 0, 1) 0,
                rgba(0, 0, 0, 1) 45%,
                rgba(0, 0, 0, 0) 90%,
                rgba(0, 0, 0, 0) 0
            )
            100% 50% / 100% 100% repeat-x;
        mask: var(--mask);
    }

    hr {
        border: 0;
        height: var(--spacing-extra-extra-large);
        width: 1px;
        background: linear-gradient(
                to bottom,
                rgba(255, 255, 255, 0.06) 0%,
                rgba(255, 255, 255, 0.2) 100%
            );
        /** TODO: Handle prefer-reduced-motion */
        animation: line 2s ease-in-out 0.6s;
        transform-origin: top;
        position: absolute;
        left: 50%;
        bottom: 15%;
    }

    @keyframes gradient {
        100% {
            --1-x-position: 25%;
            --2-x-position: 100%;
            --3-x-position: 80%;
        }
    }

    @keyframes line {
        0% {
            transform: scale(1, 0);
        }

        100% {
            transform: scale(1, 1);
        }
    }

    @media screen and (max-width: 996px) {
        .lights {
            --3-gradient-2: rgba(122, 0, 228, 0.7);
        }
    }
</style>

<div class="hero">
    <div class="lights">
        <Signature />
    </div>
    <hr>
</div>
