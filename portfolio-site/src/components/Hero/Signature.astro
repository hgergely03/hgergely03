---
import AstroIcon from "../../assets/img/icons/logo/astro.svg";
import CSharpIcon from "../../assets/img/icons/logo/c_sharp.svg";
import CssIcon from "../../assets/img/icons/logo/css.svg";
import DotNetIcon from "../../assets/img/icons/logo/dotnet.svg";
import FlutterIcon from "../../assets/img/icons/logo/flutter.svg";
import MssqlIcon from "../../assets/img/icons/logo/mssql.svg";
import ReactIcon from "../../assets/img/icons/logo/react.svg";

interface SignatureIcon {
    src: string;
    x: number;
    y: number;
}

interface SignatureText {
    x: number;
    y: number;
    gradient: string;
    mask?: string;
}

const icons: SignatureIcon[] = [
    {
        src: ReactIcon.src,
        x: 12,
        y: 28.5,
    },
    {
        src: FlutterIcon.src,
        x: 22,
        y: 31.5,
    },
    {
        src: CSharpIcon.src,
        x: 37,
        y: 30.5,
    },
    {
        src: AstroIcon.src,
        x: 44,
        y: 29.5,
    },
    {
        src: DotNetIcon.src,
        x: 65,
        y: 30.5,
    },
    {
        src: CssIcon.src,
        x: 80,
        y: 32.5,
    },
    {
        src: MssqlIcon.src,
        x: 85,
        y: 31.5,
    },
];

const signatures: SignatureText[] = [
    {
        x: 50,
        y: 33,
        gradient: "#linear-1",
    },
    {
        x: 49.5,
        y: 31.5,
        gradient: "#linear-2",
        mask: "url(#light-mask)",
    },
    {
        x: 49,
        y: 30,
        gradient: "#linear-3",
        mask: "url(#light-mask)",
    },
];
---

<style>
    .signature {
        width: 100%;
        position: relative;
    }

    h1, h2 {
        margin: 0;
    }

    h2 {
        text-transform: uppercase;
        text-align: center;
        position: absolute;
        right: 0;
        left: 0;
        top: 47%;
        font-size: var(--font-size-extra-extra-large);
    }

    svg {
        width: 100%;
    }

    svg text {
        font-family: var(--font-inter);
        stroke-width: 0.07;
        fill: transparent;
        paint-order: stroke;
        font-weight: 700;
        text-anchor: middle;
        font-size: 0.6rem;
        dominant-baseline: middle;
    }

    svg image {
        width: 2.5px;
        height: 2.5px;
    }

    #light-mask-1 {
         fill: rgba(255, 255, 255, 1);
         animation: light-mask-1 5s ease-in-out infinite alternate forwards;
    }

    #light-mask-2 {
         fill: rgba(255, 255, 255, 0.4);
         animation: light-mask-2 5s ease-in-out infinite alternate forwards;
    }

    .d-sm {
        display: none;
    }

    .icons-clip {
        clip-path: url(#text-clip);
    }

    @keyframes light-mask-1 {
        100% {
            fill: rgba(255, 255, 255, 0.4);
        }
    }

    @keyframes light-mask-2 {
        100% {
            fill: rgba(255, 255, 255, 1);
        }
    }

    @media screen and (max-width: 996px) {
        .d-lg {
            display: none;
        }

        .d-sm {
            display: block;
        }

        h2 {
            top: 55%;
        }

        svg text {
            font-size: 1.25rem;
            stroke-width: 0.1;
        }

        .icons-clip {
            clip-path: url(#text-clip-multiline);
        }

        #linear-1 stop[offset="40%"] {
            stop-color: rgba(255, 44, 44, 0.4);
        }

        #linear-1 stop[offset="100%"] {
            stop-color: rgba(255, 44, 44, 0.3);
        }
    }
</style>

<div class="signature">
<!-- Use multiple text elements for 'shadows' but hide them from screen readers. 
     See: https://stackoverflow.com/a/53004280 -->
<h1 aria-labelledby="name-0">
    <svg viewBox="0 0 100 70" aria-hidden="true">
        <defs>
            <!-- Gradients for signature and its shadows -->
            <linearGradient id="linear-1" x1="0%" y1="0%" x2="0%" y2="100%">
                <stop offset="0%" stop-color="rgba(255, 44, 44, 0.8)"></stop>
                <stop offset="40%" stop-color="rgba(255, 44, 44, 0.21)"></stop>
                <stop offset="100%" stop-color="rgba(255, 44, 44, 0.07)"></stop>
            </linearGradient>
    
            <linearGradient id="linear-2" x1="0%" y1="0%" x2="0%" y2="100%">
                <stop offset="0%" stop-color="rgba(255, 97, 97, 0.4)"></stop>
                <stop offset="70%" stop-color="rgba(122, 0, 228, 0.12)"></stop>
                <stop offset="100%" stop-color="rgba(122, 0, 228, 0)"></stop>
            </linearGradient>
    
            <linearGradient id="linear-3" x1="0%" y1="0%" x2="0%" y2="100%">
                <stop offset="0%" stop-color="rgba(92, 0, 172, 0.3)"></stop>
                <stop offset="40%" stop-color="rgba(92, 0, 172, 0.2)"></stop>
                <stop offset="100%" stop-color="rgba(92, 0, 172, 0)"></stop>
            </linearGradient>

            <!-- Masks for moving light parts -->
            <mask id="light-mask">
                <rect id="light-mask-1" x="5" y="0" width="30" height="35"/>
                <rect id="light-mask-2" x="35" y="0" width="35" height="60"/>
                <rect id="light-mask-2" x="70" y="0" width="30" height="35"/>
            </mask>
    
            <!-- Clipping path used by floating icons -->
            <clipPath id="text-clip">
                <text
                    x="50"
                    y="33"
                    stroke="url(#linear-1)"
                    text-anchor="middle"
                    font-size="0.6rem">Horváth Gergely</text
                >
            </clipPath>

            <!-- Clipping path used by floating icons on mobile -->
            <clipPath id="text-clip-multiline">
                <text
                    x="48"
                    y="20"
                    stroke="url(#linear-1)"
                    text-anchor="middle"
                    font-size="1.25rem">Horváth</text
                >
                <text
                    x="47"
                    y="36"
                    stroke="url(#linear-1)"
                    text-anchor="middle"
                    font-size="1.25rem">Gergely</text
                >
            </clipPath>
        </defs>
    
        {
            signatures.map((sig, index) => (
                <text
                    class="d-lg"
                    x={sig.x}
                    y={sig.y}
                    stroke=`url(${sig.gradient})`
                    id=`name-${index}`
                    mask={sig.mask}
                >
                    Horváth Gergely
                </text>

                <text
                    class="d-sm"
                    x={sig.x}
                    y={sig.y-15}
                    stroke=`url(${sig.gradient})`
                    id=`name-${index}`
                    mask={sig.mask}
                >
                    <tspan x="50">Horváth</tspan>
                    <tspan x="47" dy="18">Gergely</tspan>
                </text>
            ))
        }

        <!-- Floating icons -->
        <g class="icons-clip">
            {
                icons.map((icon) => (
                        <image
                            class="floating-icon"
                            x={icon.x}
                            y={icon.y}
                            href={icon.src}
                        />
                ))
            }
        </g>
    </svg>
</h1>
<h2>
    Developer. Designer. Creator.
</h2>
<div/>

<script>
    import gsap from "gsap";
    import { SplitText } from "gsap/SplitText";
    gsap.registerPlugin(SplitText);
    
    const splitText = SplitText.create("h2", { type: "words" });

    /* Solution because adding class to the last word in HTML does not work 
        as GSAP wraps the split words in div elements. 
        */
    const lastWord = splitText.words[splitText.words.length - 1];
    gsap.set(lastWord, {className: "gradient-text"});

    gsap.from(splitText.words, {
        duration: 1, 
        y: 20,
        autoAlpha: 0,
        stagger: 0.05
    });
</script>

<script src="../../scripts/wander.ts" />