---
export interface Props {
    hoverText: string;
    firstLineText: string;
    firstLineHighlightText: string;
    secondLineText: string;
    showFirstLine?: boolean;
    showSecondLine?: boolean;
}

const {
    hoverText,
    firstLineText,
    firstLineHighlightText,
    secondLineText,
    showFirstLine = true,
    showSecondLine = true,
} = Astro.props;
---

<style>
    .hover-title {
        position: relative;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
    }

    .hover-text {
        font-size: 10.25rem;
        font-weight: bold;
        text-transform: uppercase;
        text-align: center;
        margin: 0;
        color: var(--color-dark);
        background-image: linear-gradient(
            to bottom,
            rgba(255, 255, 255, 1) 0%,
            rgba(255, 255, 255, 0.4) 40%,
            rgba(255, 255, 255, 0.15) 100%
        );
        letter-spacing: 2px;
        /** Low opacity: around 0.08-0.28 */
        mask: url("#text-mask");
    }

    .title {
        position: absolute;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.5rem;
    }

    .first-line {
        font-size: 1.25rem;
        color: var(--color-light);
        font-weight: bold;
        text-transform: uppercase;
        margin: 0;
    }

    .first-line-highlight {
        background-image: var(--gradient-primary);
        margin: 0;
    }

    .second-line {
        color: var(--color-light);
        font-size: 2.75rem;
        font-weight: 500;
        text-align: center;
        opacity: 0.9;
        margin: 0;
    }

    @media screen and (max-width: 768px) {
        .hover-text {
            font-size: 15vw;
        }

        .first-line {
            font-size: 2.5vw;
        }

        .second-line {
            font-size: 4vw;
        }
    }
</style>

<!-- TODO: Get rid of multiple SVG elements / same id -->
<svg height="0">
  <mask id="text-mask">
    <radialGradient id="mask-gradient">
      <stop stop-color="rgba(255, 255, 255, 1)" offset="0%" />
      <stop stop-color="rgba(255, 255, 255, 0)" offset="100%" />
    </radialGradient>
    <rect width="2000" height="200" x="-300" y="30" fill="rgba(255, 255, 255, 0.4)" />
    <circle id="mask-circle" cx="50" cy="150" r="0" fill="url(#mask-gradient)" />
  </mask>
</svg>
<div class="hover-title">
    <p class="hover-text gradient-outline-text">{hoverText}</p>

    {
        (showFirstLine || showSecondLine) && (
            <div class="title">
                {showFirstLine && (
                    <p class="first-line">
                        {firstLineText}
                        <span class="first-line-highlight gradient-text">
                            {firstLineHighlightText}
                        </span>
                    </p>
                )}

                {showSecondLine && <p class="second-line">{secondLineText}</p>}
            </div>
        )
    }
</div>

<script>
    import gsap from "gsap";
    const titles = document.querySelectorAll('.hover-title') as NodeListOf<HTMLDivElement>;
    const maskCircle = document.getElementById("mask-circle") as SVGCircleElement | null;

    /** Add event listeners to each title as the script is only loaded once 
        (while the component is used multiple times.) */
    titles.forEach((title) => {
        title.addEventListener("mouseenter", () => {
            maskCircle?.setAttribute("r", "120");
        });

        title.addEventListener("mouseleave", () => {
            gsap.to(maskCircle, {
                attr: { r: 0 },
                duration: 0.2,
                ease: "power2.inOut",
            });
        });

        title.addEventListener("mousemove", (event) => {
            if (maskCircle) {
                const rect = title.getBoundingClientRect();
                const x = event.clientX - rect.left;
                const y = event.clientY - rect.top;
                maskCircle.setAttribute("cx", x.toString());
                maskCircle.setAttribute("cy", y.toString());
            }
        });
    });
</script>