---
export interface Props {
    hoverText: string;
    firstLineText?: string;
    firstLineHighlightText?: string;
    secondLineText: string;
}

const { hoverText, firstLineText, firstLineHighlightText, secondLineText } =
    Astro.props;
---

<style>
    .hover-title {
        position: relative;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        width: fit-content;
    }

    .hover-text {
        font-size: 10.25rem;
        font-weight: bold;
        text-transform: uppercase;
        text-align: center;
        margin: 0;
        color: var(--color-dark);
        background-image: linear-gradient(
            to bottom,
            rgba(255, 255, 255, 1) 0%,
            rgba(255, 255, 255, 0.4) 40%,
            rgba(255, 255, 255, 0.15) 100%
        );
        letter-spacing: 2px;
        /** Low opacity: around 0.08-0.28 */
        mask: url("#mask-base");
    }

    .title {
        position: absolute;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.5rem;
    }

    .first-line {
        font-size: 1.25rem;
        color: var(--color-light);
        font-weight: bold;
        text-transform: uppercase;
        margin: 0;
    }

    .first-line-highlight {
        background-image: var(--gradient-primary);
        margin: 0;
    }

    .second-line {
        color: var(--color-light);
        font-size: 2.75rem;
        font-weight: 500;
        text-align: center;
        opacity: 0.9;
        margin: 0;
    }

    @media screen and (max-width: 768px) {
        .hover-text {
            max-width: 100%;
            font-size: 15vw;
            word-break: break-word;
        }

        .first-line {
            font-size: 2.5vw;
        }

        .second-line {
            font-size: 4vw;
        }
    }
</style>

<div class="hover-title">
    <p class="hover-text gradient-outline-text">{hoverText}</p>

    <div class="title">
        {
            firstLineText && firstLineHighlightText && (
                <p class="first-line">
                    {firstLineText}
                    <span class="first-line-highlight gradient-text">
                        {firstLineHighlightText}
                    </span>
                </p>
            )
        }

        {secondLineText && <p class="second-line">{secondLineText}</p>}
    </div>
</div>

<script>
    import gsap from "gsap";

    const timeline = gsap.timeline();

    const titles = document.querySelectorAll<HTMLDivElement>(".hover-title");
    const maskCircle = document.querySelector<SVGCircleElement>(
        "#mask-circle-element",
    );

    /** Add event listeners to each title as the script is only loaded once 
        (while the component is used multiple times.) */
    titles.forEach((title) => {
        const hoverText = title.querySelector(
            ".hover-text",
        ) as HTMLParagraphElement;

        title.addEventListener("mouseenter", () => {
            timeline
                .to(hoverText, {
                    mask: "url(#mask-circle), url(#mask-base)",
                    duration: 0,
                    ease: "power2.inOut",
                })
                .to(maskCircle, {
                    attr: { r: 120 },
                    duration: 0.2,
                    ease: "power2.inOut",
                });
        });

        title.addEventListener("mouseleave", () => {
            timeline
                .to(maskCircle, {
                    attr: { r: 0 },
                    duration: 0.2,
                    ease: "power2.inOut",
                })
                .to(hoverText, {
                    mask: "url(#mask-base)",
                    duration: 0,
                    ease: "power2.inOut",
                });
        });

        title.addEventListener("mousemove", (event) => {
            const rect = title.getBoundingClientRect();
            const x = event.clientX - rect.left;
            const y = event.clientY - rect.top;
            maskCircle?.setAttribute("cx", x.toString());
            maskCircle?.setAttribute("cy", y.toString());
        });
    });
</script>
