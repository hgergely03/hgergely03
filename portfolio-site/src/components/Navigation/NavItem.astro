---
export interface Props {
    label: string;
    route: string;
    active: boolean;
}

const { label, route, active } = Astro.props;
---

<style>
    a {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.5rem;
        color: var(--color-light);
        text-decoration: none;
    }

    span {
        font-size: 1rem;
    }
    
    span.active {
        font-weight: 600;
    }
</style>

<a href={route}>
    <slot name="icon" />
    <span class={active ? "active" : ""}>{label}</span>
</a>
