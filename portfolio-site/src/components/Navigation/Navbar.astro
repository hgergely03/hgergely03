---
import { Image } from 'astro:assets';
import NavItem from "./NavItem.astro";
import HomeIcon from "../../assets/img/icons/home.png";
import HomeIconActive from "../../assets/img/icons/home-active.png";
import AboutIcon from "../../assets/img/icons/about.png";
import AboutIconActive from "../../assets/img/icons/about-active.png";
import ProjectsIcon from "../../assets/img/icons/projects.png";
import ProjectsIconActive from "../../assets/img/icons/projects-active.png";
import ContactIcon from "../../assets/img/icons/contact.png";
import ContactIconActive from "../../assets/img/icons/contact-active.png";
/* TODO: Change PNGs to SVGs? */

interface INavItem {
    label: string;
    icon: ImageMetadata;
    activeIcon: ImageMetadata;
    route: string;
}

const navItems: INavItem[] = [
    {
        label: "Home",
        icon: HomeIcon,
        activeIcon: HomeIconActive,
        route: "/",
    },
    {
        label: "About",
        icon: AboutIcon,
        activeIcon: AboutIconActive,
        route: "/about",
    },
    {
        label: "Projects",
        icon: ProjectsIcon,
        activeIcon: ProjectsIconActive,
        route: "/projects",
    },
    {
        label: "Contact",
        icon: ContactIcon,
        activeIcon: ContactIconActive,
        route: "/contact",
    },
];
---

<style>
    nav {
        display: flex;
        flex-direction: row;
        gap: var(--spacing-extra-extra-large);
        justify-content: center;
        position: sticky;
        top: var(--spacing-medium);
        padding: 0.5rem var(--spacing-extra-large);
        margin: 0 auto;
        z-index: 10;
        width: max-content;
    }

    .nav-icon {
        width: 2rem;
        height: 2rem;
    }

    .absolute-background {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        z-index: -1;
        border-radius: var(--spacing-small);
        background-image: linear-gradient(var(--color-dark), var(--color-dark)), var(--gradient-light);
        opacity: 0;
    }

    @media screen and (max-width: 992px) {
        nav {
            gap: var(--spacing-large);
            position: fixed;
            top: unset;
            bottom: var(--spacing-medium);
            left: 0;
            right: 0;
            margin: 0 auto;
            padding: var(--spacing-small) var(--spacing-large);
        }
    }

    @media screen and (max-width: 512px) {
        nav {
            gap: var(--spacing-medium);
            padding: var(--spacing-small) var(--spacing-medium);
        }
    }
</style>

<nav class="">
    <!-- Background is a separate element from nav, because the background-image property 
     necessary for gradient border cannot be animated with GSAP.
     Instead opacity animation is used, where only the background needs to be transparent. -->
    <span class="absolute-background gradient-border"></span>

    {
        navItems.map((item) => {
            const active = Astro.url.pathname === item.route;

            return (
                <NavItem
                    label={item.label}
                    route={item.route}
                    active={active}
                >
                <!-- TODO: Check image sizes and srcs (add higher res variants to smaller resolutions if needed) -->
                    <Image src={active ? item.activeIcon : item.icon} class="nav-icon" alt="" slot="icon" />
                </NavItem>
            );
        })
    }
</nav>

<script>
    import gsap from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";
    gsap.registerPlugin(ScrollTrigger);

    gsap.to(".absolute-background", {
        opacity: 1,
        ease: "power2.out", 
        duration: 0.4,
        scrollTrigger: {
            start: "top+=200",
            toggleActions: "play pause resume reverse",
        }
    }); 
</script>