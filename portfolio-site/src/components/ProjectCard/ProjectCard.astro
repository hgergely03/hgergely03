---
export interface Props {
    label: string;
    backgroundImageSrc: string;
    class?: string | string[];
    href?: string;
}

const {
    label: firstLineText,
    backgroundImageSrc,
    class: className,
    href,
    ...rest
} = Astro.props;
---

<style define:vars={{ backgroundImage: `url("${backgroundImageSrc}")` }}>
    .project-card {
        background:
            linear-gradient(
                180deg,
                rgba(0, 0, 0, 0.2) 0%,
                rgba(0, 0, 0, 0.8) 100%
            ),
            var(--backgroundImage) #353535 50% / cover no-repeat;
        border-radius: var(--spacing-small);
        padding: var(--spacing-normal) var(--spacing-normal);
        box-shadow: 0 0 7px 2px rgba(255, 255, 255, 0.02);
        display: flex;
        flex-direction: column;
        justify-content: end;
        align-items: start;
    }

    h3 {
        margin: 0;
        font-size: 1.1rem;
        font-weight: 400;
        color: rgba(255, 255, 255, 0.8);
    }

    a {
        text-decoration: none;
    }
</style>

<div class={`project-card ${className || ""}`} {...rest}>
    {
        href ? (
            <a href={href}>
                <h3>{firstLineText}</h3>
            </a>
        ) : (
            <h3>{firstLineText}</h3>
        )
    }
</div>
