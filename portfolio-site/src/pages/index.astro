---
import AnimatedCarousel from "../components/AnimatedCarousel/AnimatedCarousel.astro";
import { type ICarouselItem } from "../components/AnimatedCarousel/CarouselItem.astro";
import Bento from "../components/Bento/Bento.astro";
import Button from "../components/Button/Button.astro";
import HoverTitle from "../components/Hover title/HoverTitle.astro";
import Homepage1 from "../assets/img/icons/homepage-1.png";
import Homepage2 from "../assets/img/icons/homepage-2.png";
import Homepage3 from "../assets/img/icons/homepage-3.png";
import PlaceholderImg from "../assets/img/placeholder-1.png";
import Placeholder2Img from "../assets/img/placeholder-2.png";
import Placeholder3Img from "../assets/img/placeholder-3.png";
import Layout from "../layouts/Layout.astro";
import ProjectCard from "../components/ProjectCard/ProjectCard.astro";
import BusinessCard from "../components/BusinessCard/BusinessCard.astro";
import Footer from "../components/Footer/Footer.astro";
import type { IBentoItem } from "../components/Bento/BentoItem";


const carouselItems: ICarouselItem[] = [
    {
        label: "Located in Budapest",
        decorationSrc: Homepage1,
        decorationAlt: "",
    },
    {
        label: "Designing impactful experiences, developing full stack business solutions",
        decorationSrc: Homepage2,
        decorationAlt: "",
    },
    {
        label: "2 years experience in the industry",
        decorationSrc: Homepage3,
        decorationAlt: "",
    },
];

const bentoItems: IBentoItem[] = [
    {
        label: "Project 1",
        backgroundImageSrc: PlaceholderImg.src,
        href: "/about"
    },
    {
        label: "Project 2",
        backgroundImageSrc: Placeholder2Img.src,
    },
    {
        label: "Project 3",
        backgroundImageSrc: Placeholder3Img.src,
    },
];
---

<style>
    section {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: var(--spacing-large);
    }

    section > * {
        width: 100%;
    }

    .content {
        margin: 0 var(--spacing-layout);
        display: flex;
        flex-direction: column;
        gap: var(--spacing-extra-extra-large);
    }
</style>

<Layout title="Home">
    <!-- Hero -->

    <div class="content">
        <!-- About me -->
        <section>
            <HoverTitle
                hoverText="About"
                firstLineText="About"
                firstLineHighlightText="me"
                secondLineText="Details at a glance"
            />

            <AnimatedCarousel items={carouselItems} />

            <ProjectCard
                class="project-card-large"
                label="Experience, knowledge and achievements"
                backgroundImageSrc={PlaceholderImg.src}
                href="/about"
            />

            <Button
                href="/about"
                label="Get to know me"
                isDark={false}
                isPrimaryStroke={true}
            />
        </section>

        <!-- Projects -->
        <section>
            <HoverTitle
                hoverText="Projects"
                firstLineText="Featured"
                firstLineHighlightText="works"
                secondLineText="Projects delivering tangible and measurable impact"
            />

            <Bento items={bentoItems} />

            <Button
                href="/projects"
                label="Explore my portfolio"
                isDark={false}
                isPrimaryStroke={true}
            />
        </section>

        <!-- Contact -->
        <section>
            <HoverTitle
                hoverText="Contact"
                firstLineText="Get in"
                firstLineHighlightText="touch"
                secondLineText="Let's have a chat or just say hello"
            />

            <BusinessCard />
        </section>
    </div>

    <Footer />
</Layout>
