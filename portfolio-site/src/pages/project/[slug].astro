---
import { getCollection } from "astro:content";
import HoverTitle from "../../components/Hover title/HoverTitle.astro";
import Layout from "../../layouts/Layout.astro";
import Metrics from "../../components/Metrics/Metrics.astro";
import VideoProjectCard from "../../components/ProjectCard/VideoProjectCard.astro";
import BlogContent from "../../components/BlogContent/BlogContent.astro";
import IconCloud from "../../components/IconCloud/IconCloud.astro";
import { getEntries } from "astro:content";
import RelatedPosts from "../../components/RelatedPosts/RelatedPosts.astro";

export async function getStaticPaths() {
  const projects = await getCollection("projects");

  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const heroImageUrl = project.data.previewImgSrc?.src;
const relatedPosts = await getEntries(project.data.relatedPosts);
---

<style define:vars={{ backgroundImage: `url("${heroImageUrl}")` }}>
  .hero {
    background:
      linear-gradient(180deg, rgba(0, 0, 0, 0.2) 0%, rgba(0, 0, 0, 0.8) 100%),
      var(--backgroundImage) #353535 50% / cover no-repeat;
  }

  .hero > .hero-content {
    position: absolute;
    bottom: 50%;
    left: 50%;
    transform: translate(-50%, 50%);
  }

  .hero > .hero-content > p {
    /** TODO: Unify with .second-line from HoverTitle */
    color: var(--color-light);
    font-size: 2.75rem;
    font-weight: 500;
    text-align: center;
    opacity: 0.9;
    margin: 0;
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--spacing-normal);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--spacing-medium);
  }

  .tag {
    background-image: linear-gradient(45deg, rgba(255, 255, 255, 0.04) 0%, rgba(255, 255, 255, 0.012) 100%);
    font-size: 0.875rem;
    font-weight: bold;
    padding: var(--spacing-extra-small) var(--spacing-normal);
    border-radius: var(--spacing-medium);
  }

  section {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--spacing-large);
  }

  .content {
    margin: var(--spacing-extra-extra-large) var(--spacing-layout);
    display: flex;
    flex-direction: column;
    gap: var(--spacing-extra-extra-large);
  }
</style>

<!-- TODO: Post SEO -->
<Layout title={project.data.title}>
  <!-- TODO: https://docs.astro.build/en/guides/images/#images-in-content-collections -->
  <div class="hero">
    <div class="hero-content">
      <p>{project.data.title}</p>
      {
        project.data.tags && (
          <div class="tags">
            {project.data.tags.map((tag) => (
              <span class="gradient-border tag">{tag}</span>
            ))}
          </div>
        )
      }
    </div>
  </div>
  <div class="content">
    <!-- Details video -->
    {
      project.data.video && (
        <VideoProjectCard
          videoSrc={project.data.video.videoSrc}
          posterSrc={project.data.video.posterSrc.src}
          label={project.data.video.label}
        />
      )
    }

    <!-- Impact -->
    {
      project.data.metrics && (
        <section>
          <HoverTitle
            hoverText="Impact"
            firstLineText="Key"
            firstLineHighlightText="insights"
            secondLineText="The measurable aspects of success"
          />
          <Metrics metrics={project.data.metrics} />
        </section>
      )
    }

    <!-- Paragraphs -->
    {
      project.data.paragraphs && (
        <section>
          <HoverTitle
            hoverText="Paragraph"
            firstLineText="Lorem"
            firstLineHighlightText="ipsum"
            secondLineText="Long section title"
          />
          <BlogContent paragraphs={project.data.paragraphs} />
        </section>
      )
    }

    <!-- Technologies -->
    {
      project.data.technologies && (
        <section>
          <HoverTitle
            hoverText="Stack"
            firstLineText="Used"
            firstLineHighlightText="technology"
            secondLineText="Technologies bringing the project to life"
          />
          <IconCloud technologies={project.data.technologies} />
        </section>
      )
    }

    <!-- Related posts -->
    {
      relatedPosts && (
        <section>
          <HoverTitle
            hoverText="Related"
            firstLineText="Recommended"
            firstLineHighlightText="projects"
            secondLineText="You might be interested in these"
          />
          <RelatedPosts posts={relatedPosts} />
        </section>
      )
    }
  </div>
</Layout>
