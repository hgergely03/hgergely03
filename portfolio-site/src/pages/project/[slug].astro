---
import { getCollection } from "astro:content";
import HoverTitle from "../../components/Hover title/HoverTitle.astro";
import Layout from "../../layouts/Layout.astro";
import Metrics from "../../components/Metrics/Metrics.astro";
import VideoProjectCard from "../../components/ProjectCard/VideoProjectCard.astro";
import BlogContent from "../../components/BlogContent/BlogContent.astro";
import IconCloud from "../../components/IconCloud/IconCloud.astro";

export async function getStaticPaths() {
  const projects = await getCollection("projects");

  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const url = project.data.previewImgSrc?.src;
---

<style define:vars={{ backgroundImage: `url("${url}")` }}>
  .hero {
    background:
      linear-gradient(180deg, rgba(0, 0, 0, 0.2) 0%, rgba(0, 0, 0, 0.8) 100%),
      var(--backgroundImage) #353535 50% / cover no-repeat;
  }

  .hero > p {
    position: absolute;
    bottom: 50%;
    left: 50%;
    transform: translate(-50%, 50%);
    /** TODO: Unify with .second-line from HoverTitle */
    color: var(--color-light);
    font-size: 2.75rem;
    font-weight: 500;
    text-align: center;
    opacity: 0.9;
    margin: 0;
  }

  section {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--spacing-large);
  }

  .content {
    margin: var(--spacing-extra-extra-large) var(--spacing-layout);
    display: flex;
    flex-direction: column;
    gap: var(--spacing-extra-extra-large);
  }
</style>

<!-- TODO: Post SEO -->
<Layout title={project.data.title}>
  <!-- TODO: https://docs.astro.build/en/guides/images/#images-in-content-collections -->
  <div class="hero">
    <p>{project.data.title}</p>
  </div>
  <div class="content">
    <!-- Details video -->
    {
      project.data.video && (
        <VideoProjectCard
          videoSrc={project.data.video.videoSrc}
          posterSrc={project.data.video.posterSrc.src}
          label={project.data.video.label}
        />
      )
    }

    <!-- Impact -->
    {
      project.data.metrics && (
        <section>
          <HoverTitle
            hoverText="Impact"
            firstLineText="Key"
            firstLineHighlightText="insights"
            secondLineText="The measurable aspects of success"
          />
          <Metrics metrics={project.data.metrics} />
        </section>
      )
    }

    <!-- Paragraphs -->
    {
      project.data.paragraphs && (
        <section>
          <HoverTitle
            hoverText="Paragraph"
            firstLineText="Lorem"
            firstLineHighlightText="ipsum"
            secondLineText="Long section title"
          />
          <BlogContent paragraphs={project.data.paragraphs} />
        </section>
      )
    }

    <!-- Technologies -->
    {
      project.data.technologies && (
        <section>
          <HoverTitle
            hoverText="Technology"
            firstLineText="Used"
            firstLineHighlightText="stack"
            secondLineText="Technologies bringing the project to life"
          />
          <IconCloud technologies={project.data.technologies} />
        </section>
      )
    }

    <!-- Paragraphs -->
    {
      project.data.paragraphs && (
        <section>
          <HoverTitle
            hoverText="Paragraph"
            firstLineText="Lorem"
            firstLineHighlightText="ipsum"
            secondLineText="Long section title"
          />
          <BlogContent paragraphs={project.data.paragraphs} />
        </section>
      )
    }
  </div>
</Layout>
